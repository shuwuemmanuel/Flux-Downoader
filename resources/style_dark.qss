/* Flux Downloader - "Aqua Dark" theme */
* {
    font-family: -apple-system, "SF Pro Text", "Helvetica Neue", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #f2f2f7;
}
QMainWindow, QDialog { background-color: #1c1c1e; }
QToolBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2c2c2e, stop:1 #232325);
    border-bottom: 1px solid #3a3a3c;
    spacing: 6px; padding: 6px;
}
QToolButton { background: transparent; border: 1px solid transparent; border-radius: 8px; padding: 6px 10px; }
QToolButton:hover { background: rgba(10, 132, 255, 0.22); border: 1px solid rgba(10,132,255,0.4); }
QListWidget#sidebar { background: #202022; border: none; border-right: 1px solid #3a3a3c; padding-top: 8px; outline: 0; }
QListWidget#sidebar::item { padding: 8px 14px; border-radius: 8px; margin: 2px 8px; }
QListWidget#sidebar::item:selected { background: #0A84FF; color: white; }
QListWidget#sidebar::item:hover:!selected { background: rgba(10,132,255,0.15); }
QTableWidget {
    background: #1c1c1e; alternate-background-color: #232325; gridline-color: #3a3a3c;
    border: none; selection-background-color: rgba(10,132,255,0.3); selection-color: #f2f2f7;
}
QHeaderView::section { background: #2c2c2e; color: #a1a1a6; border: none; border-bottom: 1px solid #3a3a3c; padding: 6px; font-weight: 600; }
QProgressBar { border: 1px solid #3a3a3c; border-radius: 6px; background: #2c2c2e; text-align: center; height: 14px; }
QProgressBar::chunk { border-radius: 6px; background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #38aaff, stop:1 #0A84FF); }
QPushButton { background: #2c2c2e; border: 1px solid #48484a; border-radius: 8px; padding: 6px 16px; color: #f2f2f7; }
QPushButton:hover { border: 1px solid #0A84FF; }
QPushButton#primary { background: #0A84FF; color: white; border: none; font-weight: 600; }
QLineEdit, QComboBox, QSpinBox, QTextEdit { background: #2c2c2e; border: 1px solid #48484a; border-radius: 8px; padding: 6px 8px; color: #f2f2f7; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid #0A84FF; }
QStatusBar { background: #1c1c1e; border-top: 1px solid #3a3a3c; }
QMenu { background: #2c2c2e; border: 1px solid #48484a; border-radius: 8px; padding: 4px; }
QMenu::item { padding: 6px 20px; border-radius: 6px; }
QMenu::item:selected { background: #0A84FF; color: white; }
QToolBar::separator { background: #3a3a3c; width: 1px; margin: 4px 6px; }
